{
  // Static-assets-only Worker: no server code, Cloudflare just serves ./public.
  // Deploy command in the dashboard stays the default `npx wrangler deploy`.
  "name": "tc-ventures-site",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
